# SparkSDK integration test configuration.
#
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# All variables can also be exported in your shell or set via CI secrets.
#
# Unit tests do NOT require any of these — they use public BIP-39 test vectors.
# Only the integration suite (`IntegrationTests.swift`) reads these.

# --- Required for integration tests ---

# Funded mainnet/testnet wallet used as the primary integration test wallet.
# Must contain at least 500 sats to run the full suite.
SPARK_TEST_WALLET_A_MNEMONIC="word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12"

# Second wallet used for transfer/receive flows. Does not need to be funded.
SPARK_TEST_WALLET_B_MNEMONIC="word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12"

# --- Optional: static deposit tests ---
# If unset, static deposit tests are skipped.

# Wallet that owns a funded static deposit address.
# SPARK_TEST_STATIC_DEPOSIT_MNEMONIC="word1 word2 ... word12"

# BIP-32 account index for the static deposit wallet (default: 11).
# SPARK_TEST_STATIC_DEPOSIT_ACCOUNT=11

# Static deposit P2TR address with confirmed UTXOs.
# SPARK_TEST_STATIC_DEPOSIT_ADDRESS="bc1p..."

# Confirmed static deposit txid you can claim once.
# SPARK_TEST_STATIC_DEPOSIT_TXID="..."

# Destination address for withdraw fee estimation.
# SPARK_TEST_STATIC_DEPOSIT_WITHDRAW_ADDRESS="bc1p..."

# --- Optional: external lightning ---

# External lightning address for paid-invoice tests (e.g. user@domain.com).
# SPARK_TEST_LIGHTNING_ADDRESS=""
